# Copy to .env and fill in. .env is gitignored — never commit real values.

# data.gov.in personal API key (My Account -> API Key).
# Do NOT use the shared demo key from blog tutorials: it is rate-limited
# across everyone who copied it, and the hourly ingester will fail unpredictably.
DATA_GOV_IN_API_KEY=

# OpenAQ v3 key — free signup at https://explore.openaq.org/register
# Sent as the "X-API-Key" request header, not as a query parameter.
# Optional: read by scripts/probe_history.py (Gate 0.2) and nothing else, so
# leaving it blank does not affect the ingester or any of the gates.
OPENAQ_API_KEY=

# Phase 1. Neon Postgres connection string (neon.tech -> your project -> Connect).
# Shape: postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=verify-full&sslrootcert=<CA bundle>
#
# Use verify-full, not the sslmode=require Neon's dashboard hands you. `require`
# encrypts and then verifies nothing — not the certificate, not the hostname —
# so anyone who can answer for the Neon hostname can present a self-signed cert
# and collect the password and every row, silently. `verify-full` authenticates
# the server, and it needs a CA bundle to authenticate against.
#
# `sslrootcert=system` is the documented way to say "use the OS trust store" and
# it does NOT work here, on either platform. psycopg[binary] ships its own
# OpenSSL, built elsewhere, whose compiled-in default CA location matches
# neither Windows (which has no readable file store) nor a GitHub runner. Both
# fail identically, with `certificate verify failed`, and on the runner that
# also kills the crash handler, so the job writes no log row at all. Measured
# 2026-08-19; it cost one CPCB bulletin, permanently. Name the file instead:
#
#   GitHub Actions / Ubuntu   sslrootcert=/etc/ssl/certs/ca-certificates.crt
#   Windows                   sslrootcert=<path>\site-packages\certifi\cacert.pem
#                             (python -c "import certifi;print(certifi.where())")
#
# The two values differ by design. Do not copy one into the other.
#
# Neon, not Render free Postgres — that one is deleted at day 91 (build plan §2).
#
# The same value goes into the GitHub repo as an Actions secret, entered by
# hand. It is never printed: scripts/db.py redacts anything password-shaped
# before it can reach a CI log, because Actions logs on a public repo are public.
DATABASE_URL=

# Phase 2. Telegram bot token from @BotFather. Shape: '<numeric id>:<secret>'.
#
# Read by scripts/send_alerts.py. The same value goes into the GitHub Actions
# secrets and into the bot Worker as an encrypted Cloudflare secret — three
# copies of one credential, entered by hand each time, never printed. It grants
# full control of the bot: reading every subscriber's messages and sending as
# us. scripts/telegram_api.py strips it out of error text before anything is
# printed or stored, because the token travels in the URL path rather than in a
# header, so every urllib error that quotes the URL quotes the token.
TELEGRAM_BOT_TOKEN=

# Phase 2. Any long random string you choose — it is not issued by anyone.
#
# Used ONLY by the bot Worker (bot/), not by any Python script, so it does not
# need to be in this file for the ingester or the sender to run. It is listed
# here because it is a secret this project has, and one that is easy to treat as
# optional: the webhook URL is public, and this header is the only thing between
# a stranger and the ability to create subscriptions and forge feedback taps.
#
# The same value goes in twice: as a Worker secret, and as `secret_token` in the
# setWebhook call (see bot/README.md). If they disagree, every update is
# rejected with 401 and the bot goes silent with no other symptom.
TELEGRAM_WEBHOOK_SECRET=
