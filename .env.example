# Copy to .env and fill in. .env is gitignored — never commit real values.

# data.gov.in personal API key (My Account -> API Key).
# Do NOT use the shared demo key from blog tutorials: it is rate-limited
# across everyone who copied it, and the hourly ingester will fail unpredictably.
DATA_GOV_IN_API_KEY=

# OpenAQ v3 key — free signup at https://explore.openaq.org/register
# Sent as the "X-API-Key" request header, not as a query parameter.
OPENAQ_API_KEY=

# Phase 1. Postgres connection string (Supabase or Neon free tier).
# NOT Render free Postgres — it is deleted at day 91.
DATABASE_URL=

# Phase 2. Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
